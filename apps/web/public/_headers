# Les en-têtes de l'atelier, pour Cloudflare Pages.
#
# Ce fichier remplace la section `headers` de `vercel.json`. Il est copié tel
# quel dans `dist/` par Vite, et Pages le lit à la racine du site.
#
# La vérification de bout en bout (`e2e/`) sert l'application avec exactement
# ces valeurs, dans un vrai Chromium, mode avion compris : c'est là qu'un
# `sw.js` mis en cache s'attrape, pas en production.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'

# Les noms portent une empreinte : un fichier donné ne change jamais.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Un service worker mis en cache, c'est une application figée dans une version
# qu'on ne peut plus corriger.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# Il liste les empreintes du moment ; périmé, il ferait précharger des fichiers
# disparus.
/precache.json
  Cache-Control: public, max-age=0, must-revalidate

# Il pointe vers les empreintes courantes.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=3600
